# Sensible defaults for this project. Run `idf.py menuconfig` to override.

# --- BLE (NimBLE, client/central role only) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=6

# --- Wi-Fi / lwIP ---
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_IPV4_NAPT=n

# --- HTTP server (captive portal + admin page) ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- FreeRTOS / misc ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Partition table: single-app large enough for BLE + Wi-Fi ---
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
